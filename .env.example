# Copy this file to .env and fill in the values. Do NOT commit your .env file.
# Example environment variables for the Home Automation project
# Adjust names to match variables referenced by your code/build flags.

# WiFi
WIFI_SSID=your_wifi_ssid_here
WIFI_PASS=your_wifi_password_here

# SinricPro credentials (APP_KEY / APP_SECRET)
APP_KEY=your_sinricpro_app_key_here
APP_SECRET=your_sinricpro_app_secret_here

# Device IDs (move your device IDs here so they're not in source)
DEVICE_ID_1=68e96d365918d860c0a2e116
DEVICE_ID_2=68e96dd65918d860c0a2e148
DEVICE_ID_3=68e96e025918d860c0a2e179

# MQTT / Broker (if you use it)
MQTT_HOST=broker.example.com
MQTT_PORT=1883
MQTT_USER=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password

# Other
DEVICE_NAME=home-automation-device

# End of file